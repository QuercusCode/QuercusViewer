# Copy this file to .env and fill in real values.
# These are read client-side (via import.meta.env) and must be prefixed with VITE_.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Without the two vars above, the app still runs but every Supabase-dependent
# feature (auth, AI chat, saving/loading structures) is disabled.

# --- Supabase Edge Functions (supabase/functions/) ---
# These are server-side secrets set via `supabase secrets set`, not read by
# the frontend build. Listed here so they're documented somewhere.
#   SUPABASE_URL       - same project URL as above
#   SUPABASE_ANON_KEY  - same anon key as above
#   OPENAI_API_KEY     - used by chat_handler and embed_structure
#   ANTHROPIC_API_KEY  - used by chat_handler
